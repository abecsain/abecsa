generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    // ADMIN, MANAGER, ENGINEER, CUSTOMER
  phone         String?
  avatar        String?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  department    String?
  jobTitle      String?
  hourlyRate    Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  customerProfile   CustomerProfile?
  managedProjects   Project[]           @relation("ManagedProjects")
  assignedTasks     Task[]              @relation("AssignedTasks")
  createdTasks      Task[]              @relation("CreatedTasks")
  projectMemberships ProjectMember[]
  uploadedFiles     File[]
  createdFolders    Folder[]
  sentNotices       NoticeMessage[]     @relation("SentNotices")
  assignedTickets   SupportTicket[]     @relation("AssignedTickets")
  sentTicketMsgs    TicketMessage[]
  crmLeadsManaged   CrmLead[]           @relation("ManagedLeads")
  crmActivities     CrmActivity[]
  whatsappAccounts  WhatsAppAccount[]
  whatsappMessages  WhatsAppMessage[]   @relation("SentWhatsAppMessages")
  notifications     Notification[]
  leaveRequests     LeaveRequest[]      @relation("UserLeaves")
  approvedLeaves    LeaveRequest[]      @relation("ApprovedLeaves")
  attendances       Attendance[]
  workLogs          WorkLog[]
  auditLogs         AuditLog[]
  taskComments      TaskComment[]
  visitorSessions   VisitorSession[]
  scratchGifts      ScratchGift[]

  // Supabase Legacy & Extended User Attributes
  managerId         String?
  isLocked          Boolean             @default(false)
  visiblePassword   String?

  userAssets        UserAsset[]
  websitesOwned     Website[]           @relation("OwnedWebsites")
  websitesManaged   Website[]           @relation("ManagedWebsites")
  visitorLogs       VisitorLog[]
  examsCreated      Exam[]              @relation("CreatedExams")
  examAttempts      ExamAttempt[]
  siteAnalytics     SiteAnalytic[]
  chatMessages      ChatMessage[]
}

model CustomerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  businessType      String?
  address           String?
  gstNumber         String?
  assignedManagerId String?
  leadSource        String?
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE, PROSPECT
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projects          Project[]
  quotations        Quotation[]
  invoices          Invoice[]
  payments          Payment[]
  folders           Folder[]
  files             File[]
  noticesReceived   NoticeMessage[]
  supportTickets    SupportTicket[]
  whatsappMessages  WhatsAppMessage[]
}

model Project {
  id              String          @id @default(uuid())
  projectId       String          @unique // e.g. ABC-PRJ-101
  name            String
  description     String?
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  managerId       String?
  manager         User?           @relation("ManagedProjects", fields: [managerId], references: [id])
  serviceCategory String          // Web, Mobile, ERP, AI, etc.
  budget          Float           @default(0)
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String          @default("PLANNING") // INQUIRY, PLANNING, QUOTATION_SENT, APPROVED, IN_PROGRESS, UNDER_REVIEW, TESTING, CLIENT_APPROVAL, COMPLETED, ON_HOLD, CANCELLED
  startDate       DateTime?
  deliveryDate    DateTime?
  techStack       String?         // comma-separated or JSON
  progress        Int             @default(0) // 0 - 100
  requirements    String?
  stagingUrl      String?
  repoUrl         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         ProjectMember[]
  tasks           Task[]
  milestones      Milestone[]
  quotations      Quotation[]
  invoices        Invoice[]
  folders         Folder[]
  files           File[]
  supportTickets  SupportTicket[]
  workLogs        WorkLog[]
}

model ProjectMember {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("ENGINEER") // MANAGER, ENGINEER, LEAD
  assignedAt  DateTime  @default(now())

  @@unique([projectId, userId])
}

model Task {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assignedToId    String?
  assignedTo      User?           @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById     String?
  createdBy       User?           @relation("CreatedTasks", fields: [createdById], references: [id])
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String          @default("TODO")   // TODO, IN_PROGRESS, CODE_REVIEW, COMPLETED
  startDate       DateTime?
  dueDate         DateTime?
  estimatedHours  Float           @default(0)
  actualHours     Float           @default(0)
  order           Int             @default(0)
  deliverableUrl  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments        TaskComment[]
  checklists      TaskChecklist[]
  workLogs        WorkLog[]
}

model TaskComment {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment     String
  isInternal  Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Milestone {
  id          String               @id @default(uuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      String               @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED_FOR_APPROVAL, APPROVED, REJECTED
  order       Int                  @default(0)
  clientNote  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  approvals   MilestoneApproval[]
}

model MilestoneApproval {
  id          String    @id @default(uuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status      String    // APPROVED, REJECTED
  feedback    String?
  decidedAt   DateTime  @default(now())
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique // e.g. QT-2026-001
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  title           String
  currency        String          @default("INR")
  subtotal        Float           @default(0)
  discount        Float           @default(0)
  taxRate         Float           @default(18.0)
  taxAmount       Float           @default(0)
  totalAmount     Float           @default(0)
  paymentTerms    String?
  validUntil      DateTime?
  notes           String?
  termsConditions String?
  status          String          @default("SENT") // DRAFT, SENT, VIEWED, APPROVED, REJECTED, CONVERTED_TO_PROJECT, CONVERTED_TO_INVOICE
  clientResponse  String?
  pdfUrl          String?
  revisionNumber  Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]
  invoices        Invoice[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  amount      Float     @default(0)
}

model Invoice {
  id              String          @id @default(uuid())
  invoiceNumber   String          @unique // e.g. INV-2026-001
  quotationId     String?
  quotation       Quotation?      @relation(fields: [quotationId], references: [id])
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  issueDate       DateTime        @default(now())
  dueDate         DateTime
  currency        String          @default("INR")
  subtotal        Float           @default(0)
  taxAmount       Float           @default(0)
  totalAmount     Float           @default(0)
  amountPaid      Float           @default(0)
  balanceAmount   Float           @default(0)
  status          String          @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  paymentTerms    String?
  notes           String?
  pdfUrl          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  amount      Float     @default(0)
}

model Payment {
  id                    String          @id @default(uuid())
  invoiceId             String
  invoice               Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId            String
  customer              CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount                Float
  paymentDate           DateTime        @default(now())
  paymentMethod         String          @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, CREDIT_CARD, CASH, CHEQUE, ONLINE
  transactionReference  String?
  receiptUrl            String?
  status                String          @default("VERIFIED") // PENDING_VERIFICATION, VERIFIED, REJECTED
  verifiedById          String?
  notes                 String?
  createdAt             DateTime        @default(now())
}

model Folder {
  id                String          @id @default(uuid())
  name              String
  parentId          String?
  parent            Folder?         @relation("FolderHierarchy", fields: [parentId], references: [id])
  children          Folder[]        @relation("FolderHierarchy")
  projectId         String?
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?           @relation(fields: [createdById], references: [id])
  isCustomerVisible Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  files             File[]
}

model File {
  id                String          @id @default(uuid())
  folderId          String?
  folder            Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedById      String?
  uploadedBy        User?           @relation(fields: [uploadedById], references: [id])
  fileName          String
  originalName      String
  fileUrl           String
  fileType          String          // PDF, IMAGE, DOCX, ZIP, OTHER
  fileSize          Int             @default(0) // bytes
  mimeType          String?
  isCustomerVisible Boolean         @default(true)
  description       String?
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model NoticeMessage {
  id          String          @id @default(uuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User            @relation("SentNotices", fields: [senderId], references: [id])
  title       String
  message     String
  priority    String          @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  actionUrl   String?
  actionLabel String?
  isRead      Boolean         @default(false)
  readAt      DateTime?
  createdAt   DateTime        @default(now())
}

model SupportTicket {
  id            String          @id @default(uuid())
  ticketNumber  String          @unique // e.g. TIK-1001
  customerId    String
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id])
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  subject       String
  description   String
  category      String          @default("GENERAL") // TECHNICAL, BILLING, FEATURE_REQUEST, BUG, GENERAL
  priority      String          @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status        String          @default("OPEN")    // OPEN, ASSIGNED, IN_PROGRESS, WAITING_FOR_CUSTOMER, RESOLVED, CLOSED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      TicketMessage[]
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User          @relation(fields: [senderId], references: [id])
  message       String
  isInternal    Boolean       @default(false)
  attachmentUrl String?
  createdAt     DateTime      @default(now())
}

model CrmLead {
  id                  String        @id @default(uuid())
  leadNumber          String        @unique // e.g. LEAD-2026-001
  name                String
  email               String
  phone               String?
  companyName         String?
  serviceInterested   String?
  budgetRange         String?
  preferredContact    String?       @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  message             String?
  status              String        @default("NEW_LEAD") // NEW_LEAD, DISCOVERY, QUOTATION_SENT, NEGOTIATION, CONVERTED, LOST
  assignedManagerId   String?
  assignedManager     User?         @relation("ManagedLeads", fields: [assignedManagerId], references: [id])
  score               Int           @default(50)
  source              String?       @default("WEBSITE_CONTACT")
  convertedCustomerId String?
  convertedProjectId  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  activities          CrmActivity[]
}

model CrmActivity {
  id            String    @id @default(uuid())
  leadId        String
  lead          CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  activityType  String    // CALL, EMAIL, WHATSAPP, MEETING, NOTE, STATUS_CHANGE
  notes         String
  createdAt     DateTime  @default(now())
}

model WhatsAppAccount {
  id                String            @id @default(uuid())
  accountType       String            // COMPANY_CENTRAL, MANAGER_PERSONAL
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber       String?
  businessAccountId String?
  connectionStatus  String            @default("DISCONNECTED") // CONNECTED, PAIRING_QR, WAITING_FOR_PAIRING, DISCONNECTED
  qrCode            String?
  sessionBundle     String?           // Cloud-synced Baileys multi-file credentials bundle
  lastHeartbeat     DateTime?
  webhookUrl        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  messages          WhatsAppMessage[]
}

model WhatsAppTemplate {
  id            String    @id @default(uuid())
  templateName  String    @unique
  category      String    // GREETING, PROJECT_UPDATE, QUOTATION_ALERT, PAYMENT_REMINDER, GENERAL
  language      String    @default("en")
  bodyText      String
  variablesJson String?   // e.g. ["customer_name", "project_name"]
  isApproved    Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model WhatsAppMessage {
  id              String            @id @default(uuid())
  accountId       String
  account         WhatsAppAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?             @relation("SentWhatsAppMessages", fields: [senderId], references: [id])
  recipientPhone  String
  recipientName   String?
  customerId      String?
  customer        CustomerProfile?  @relation(fields: [customerId], references: [id])
  messageType     String            @default("CUSTOM_TEXT") // TEMPLATE, CUSTOM_TEXT, MEDIA, QUOTATION_ALERT, INVOICE_ALERT, GREETING
  templateName    String?
  content         String
  mediaUrl        String?
  status          String            @default("SENT") // QUEUED, SENT, DELIVERED, READ, FAILED
  failureReason   String?
  messageId       String?           // e.g. wamid.HBg...
  sentAt          DateTime          @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  linkUrl   String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model LeaveRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveType     String    // CASUAL, SICK, PAID, UNPAID
  startDate     DateTime
  endDate       DateTime
  totalDays     Int       @default(1)
  reason        String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById  String?
  approvedBy    User?     @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @default(now())
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  status    String    @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT
  notes     String?
  createdAt DateTime  @default(now())
}

model WorkLog {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?     @relation(fields: [taskId], references: [id])
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  date            DateTime  @default(now())
  hoursSpent      Float     @default(1.0)
  description     String
  deliverablesUrl String?
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
}

model CompanySettings {
  id              String    @id @default("abecsa-settings")
  companyName     String    @default("ABECSA Software Solutions")
  tagline         String    @default("Enterprise Digital & Software Engineering")
  logoUrl         String    @default("/logo.png")
  email           String    @default("contact@abecsa.in")
  phone           String    @default("+91 98765 43210")
  address         String    @default("Cyber City Tech Park, Tower B, Level 4, Bengaluru, Karnataka 560100")
  website         String    @default("https://abecsa.in")
  gstNumber       String    @default("29AABCA1234F1Z8")
  currency        String    @default("INR")
  currencySymbol  String    @default("₹")
  defaultTaxRate  Float     @default(18.0)
  invoicePrefix   String    @default("INV-2026-")
  quotationPrefix String    @default("QT-2026-")
  whatsappNumber  String    @default("+91 98765 43210")
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPass        String?
  isConfigured    Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
}

model SoftwareProduct {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. ABECSA-ERP-01
  name            String
  category        String    // ERP, Healthcare, Invoicing, Mobile, Logistics, E-Commerce, Education, POS
  description     String
  price           Float     // in INR
  billingType     String    @default("ONE_TIME") // ONE_TIME, ANNUAL, MONTHLY
  badge           String?   // "Bestseller", "New Release", "Hot"
  features        String    // JSON array or comma-separated strings
  demoUrl         String?
  techStack       String?
  imageUrl        String?
  whatsappPhone   String    @default("+91 98765 43210")
  isActive        Boolean   @default(true)
  salesCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VisitorSession {
  id            String       @id @default(uuid())
  visitorToken  String       @unique // e.g. vis_abc123 stored in cookie / localStorage
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress     String?
  userAgent     String?
  deviceType    String?      // Mobile, Desktop, Tablet
  city          String?
  name          String?
  email         String?
  phone         String?
  landingPage   String?
  referrer      String?
  pageViewCount Int          @default(1)
  loginCount    Int          @default(0)
  lastActiveAt  DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  pageViews     PageView[]
}

model PageView {
  id          String          @id @default(uuid())
  sessionId   String
  session     VisitorSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path        String          // e.g. /shop, /customer/quotations
  pageTitle   String?
  referrer    String?
  durationSec Int             @default(0)
  createdAt   DateTime        @default(now())
}

model ScratchGift {
  id               String    @id @default(uuid())
  slug             String    @unique // e.g. gift_abc123 for URL /gift/gift_abc123
  title            String    // e.g. "Exclusive Diwali Gift for Sharma Infotech"
  prizeTitle       String    // e.g. "FLAT ₹15,000 OFF on Next Sprint"
  prizeDescription String?   // Details or terms
  couponCode       String?   // e.g. "ABECSA-GIFT-99"
  customerName     String?   // Optional client recipient
  customerPhone    String?   // Optional mobile / WhatsApp number
  buttonText       String    @default("Claim Gift on WhatsApp") // Custom button text
  redirectionType  String    @default("WHATSAPP") // "WHATSAPP" or "CUSTOM_URL"
  customUrl        String?   // If redirectionType is CUSTOM_URL
  whatsappMessage  String?   // Custom WhatsApp prefilled message
  isScratched      Boolean   @default(false)
  isClaimed        Boolean   @default(false)
  scratchedAt      DateTime?
  claimedAt        DateTime?
  expiresAt        DateTime?
  createdById      String
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CatalogProduct {
  id                    String    @id @default(uuid())
  code                  String    @unique // e.g. POS-BILLING, CRM-CORE
  name                  String
  category              String    // BUSINESS_MANAGEMENT, INDUSTRY_SPECIFIC, WEBSITE_DEV, APP_DEV, INFRASTRUCTURE
  shortDescription      String
  fullDescription       String?
  icon                  String?   // Lucide icon name, e.g. "Receipt", "Layers", "Smartphone"
  imageUrl              String?
  basePrice             Float     @default(0) // 0 if Price on Request
  recurringPrice        Float     @default(0)
  recurringInterval     String?   @default("MONTHLY") // MONTHLY, ANNUALLY, ONE_TIME
  isPriceOnRequest      Boolean   @default(false)
  keyFeatures           String    // JSON array of strings
  configurableAddons    String?   // JSON array of objects: { id, name, price, recurringPrice, sharedModuleId }
  suitableFor           String?   // e.g. "Retail Shops, Distributors, Supermarkets"
  recommendedDatabaseTier String? // e.g. "5 GB"
  deploymentOptions     String?   // e.g. "Cloud SaaS, Hybrid, Self-Hosted On-Premise"
  pricingModel          String    @default("ONE_TIME") // ONE_TIME, SUBSCRIPTION, HYBRID
  sharedModuleIds       String?   // JSON array of shared module identifiers
  compatibleProductIds  String?   // JSON array of compatible product codes
  isFeatured            Boolean   @default(false)
  isActive              Boolean   @default(true)
  orderIndex            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model CatalogPackage {
  id                    String    @id @default(uuid())
  slug                  String    @unique // e.g. starter, retail-pro, business-complete, enterprise
  name                  String
  category              String    @default("SOFTWARE") // SOFTWARE, WEBSITE
  tagline               String?
  description           String?
  badge                 String?   // "Most Popular", "Starter Choice", "Best Value"
  basePrice             Float     @default(0)
  recurringPrice        Float     @default(0)
  recurringInterval     String    @default("ANNUALLY")
  discountAmount        Float     @default(0) // Package bundle discount
  includedProductCodes  String    // JSON array of CatalogProduct codes
  includedFeatures      String    // JSON array of highlights
  databaseTier          String?   // e.g. "5 GB"
  userLimit             String?   // e.g. "Up to 5 Users"
  productLimit          String?   // e.g. "1,000 Products"
  supportTier           String?   // e.g. "Priority WhatsApp & Dedicated Delivery Manager"
  isFeatured            Boolean   @default(false)
  isActive              Boolean   @default(true)
  orderIndex            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model DatabaseStoragePlan {
  id                      String    @id @default(uuid())
  sizeGb                  Float     @unique // 1, 2, 5, 10, 15, 25, 50, 100
  label                   String    // e.g. "15 GB High-Speed NVMe Storage"
  monthlyPrice            Float     @default(0)
  annualPrice             Float     @default(0)
  storageType             String    @default("Managed PostgreSQL / NVMe SSD")
  recommendedBusinessSize String?   // e.g. "Mid-Size Retailer (10k-50k invoices/yr)"
  backupInfo              String    @default("Automated Daily Cloud Backups + Point-in-Time Recovery")
  isActive                Boolean   @default(true)
  orderIndex              Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model StorageEstimatorRule {
  id                      String    @id @default("default-rule")
  avgImageSizeBytes       Int       @default(307200) // 300 KB
  avgProductRecordBytes   Int       @default(4096)   // 4 KB
  avgCustomerRecordBytes  Int       @default(2048)   // 2 KB
  avgBillRecordBytes      Int       @default(3072)   // 3 KB
  avgBillItemRecordBytes  Int       @default(512)    // 512 bytes
  overheadAndIndexFactor  Float     @default(1.35)   // 35% index & WAL overhead
  safetyBufferPercent     Float     @default(20.0)   // 20% safety headroom
  externalStorageNotice   String    @default("Product images are stored securely on Cloud Object Storage (CDN), preserving primary database performance.")
  updatedAt               DateTime  @updatedAt
}

model SoftwareQuotationRequest {
  id                    String    @id @default(uuid())
  requestNumber         String    @unique // e.g. "REQ-2026-101"
  customerName          String
  businessName          String?
  email                 String
  phone                 String
  city                  String?
  businessType          String?
  preferredContact      String    @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  selectedProducts      String    // JSON array
  selectedDatabaseTier  String?
  websiteRequirements   String?   // JSON
  oneTimeTotal          Float     @default(0)
  recurringTotal        Float     @default(0)
  recurringInterval     String?   @default("ANNUALLY")
  discountTotal         Float     @default(0)
  taxAmount             Float     @default(0)
  grandTotal            Float     @default(0)
  status                String    @default("NEW") // NEW, REVIEWING, CONTACTED, QUOTATION_SENT, NEGOTIATION, APPROVED, REJECTED, COMPLETED
  internalNotes         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model InteractiveDemo {
  id                    String    @id @default(uuid())
  title                 String
  category              String
  tagline               String
  description           String
  techStack             String    // JSON array of strings
  keyFeatures           String    // JSON array of strings
  previewUrl            String    // Live demo URL
  imageUrl              String?   // Demo image shown in card
  metrics               String?   // e.g. "98 Lighthouse Speed Score"
  isActive              Boolean   @default(true)
  orderIndex            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// =========================================================================
// SUPABASE UNIFIED SUITE: APPS, WEBSITES, EXAMS, COURSES, ASSETS & ANALYTICS
// =========================================================================

model App {
  id            String    @id @default(uuid())
  name          String
  description   String?
  version       String    @default("1.0")
  category      String    @default("General")
  iconUrl       String?
  apkUrl        String
  apkFilename   String?
  downloadCount Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CourseApplication {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  phone       String
  courseName  String
  branch      String?
  message     String?
  status      String    @default("Pending") // Pending, Reviewed, Approved, Rejected
  type        String    @default("Course")  // Course, Internship, Student Ambassador
  createdAt   DateTime  @default(now())
}

model ChatMessage {
  id             Int       @id @default(autoincrement())
  senderId       String
  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String?
  content        String
  createdAt      DateTime  @default(now())
}

model Website {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation("OwnedWebsites", fields: [userId], references: [id], onDelete: SetNull)
  managerId   String?
  manager     User?     @relation("ManagedWebsites", fields: [managerId], references: [id], onDelete: SetNull)
  name        String
  url         String
  description String?
  category    String    @default("General")
  iconUrl     String?
  status      String    @default("Active") // Active, Pending, Maintenance, Suspended
  plan        String?   @default("Standard Cloud NVMe")
  expiryDate  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserAsset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // License, Certificate, Image, Key, Document
  value     String
  createdAt DateTime @default(now())
}

model VisitorLog {
  id        String   @id @default(uuid())
  imageUrl  String
  visitorId String?
  visitor   User?    @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  metadata  String?  @default("{}") // JSON string
  createdAt DateTime @default(now())
}

model Exam {
  id              String        @id @default(uuid())
  name            String
  googleFormUrl   String
  startTime       DateTime
  durationMinutes Int
  createdBy       String?
  creator         User?         @relation("CreatedExams", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  attempts        ExamAttempt[]
}

model ExamAttempt {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  status          String    @default("started") // started, completed, flagged
  violationReason String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@unique([userId, examId])
}

model SiteAnalytic {
  id        String   @id @default(uuid())
  pagePath  String
  visitorId String?
  visitor   User?    @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  sessionId String?
  metadata  String?  @default("{}") // JSON string
  createdAt DateTime @default(now())
}



